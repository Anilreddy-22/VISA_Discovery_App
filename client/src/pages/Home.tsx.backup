                    if (currentUseCaseIndex < useCases.length - 1) {
                      setCurrentUseCaseIndex(currentUseCaseIndex + 1);
                      window.scrollTo({ top: 0, behavior: 'smooth' });
                    } else {
                      nextStep("roi");
                    }
                  }}
                >
                  {currentUseCaseIndex < useCases.length - 1 ? "Next Use Case" : "View ROI Projection"} <ChevronRight className="ml-2 h-4 w-4" />
                </Button>
