                            <SelectItem value="Q1 2026">Q1 2026</SelectItem>
                            <SelectItem value="Q2 2026">Q2 2026</SelectItem>
                          </SelectContent>
                        </Select>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
