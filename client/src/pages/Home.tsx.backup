                  <div className="space-y-4">
                    <div className="text-sm font-medium text-white/60 uppercase tracking-wider">Current Use Case</div>
                    <div className="grid grid-cols-2 gap-4">
                      <div>
                        <div className="text-2xl font-mono font-bold">${(currentUseCase.calculatedRevenue || 0).toLocaleString()}</div>
